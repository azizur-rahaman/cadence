# Cadence (Level 10) Environment Configuration
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence
DATABASE_URL=postgresql+psycopg://cadence:cadence@db:5432/cadence

# Deterministic application clock (default: Wed Nov 11, 2026 09:00 AM America/Chicago)
APP_NOW=2026-11-11T15:00:00Z
CLOCK_MODE=live
COMPANY_TIMEZONE=America/Chicago

# API Auth & CORS
AUTH_SECRET=cadence-local-dev-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend public API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
